# HealthMate AI Engine 环境变量模板
# 复制为 .env 后填入真实值

# --- AI Provider（dashscope / ollama） ---
HM_AI_PROVIDER=dashscope
HM_DASHSCOPE_API_KEY=your-dashscope-api-key
HM_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HM_DASHSCOPE_FAST_MODEL=qwen3.6-flash
HM_DASHSCOPE_MED_MODEL=qwen3.6-flash

HM_OLLAMA_BASE_URL=http://localhost:11434/v1
HM_OLLAMA_FAST_MODEL=qwen2.5:7b
HM_OLLAMA_MED_MODEL=healthmate-med

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=health-mate

# --- OpenAI 兼容 ---
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- MySQL ---
HM_MYSQL_URL=mysql+pymysql://root:password@localhost:3306/healthmate

# --- Redis ---
HM_REDIS_URL=redis://localhost:6379/0
